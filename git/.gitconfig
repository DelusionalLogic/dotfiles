[user]
	email = jesper@jnsn.dev
	name = Jesper Jensen
	signingkey = F1FBF142B8152A85
[push]
	default = current
	autoSetupRemote = true
[credential]
	helper = cache
[status]
	short = false
[color]
	ui = auto
[mergetool]
	path = nvim
[alias]
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	unstage = reset HEAD --
	last = log -1 HEAD
[branch]
	autosetuprebase = always
[pull]
	rebase = true
[submodule]
	recurse = true
[merge]
	tool = nvimdiff
	conflictstyle = zdiff3
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicprefix = true
[commit]
	verbose = true
[rebase]
	autoStash = true
	autoSquash = true
[init]
	defaultBranch = main
